# Cópia: cp .env.example .env && chmod 600 .env
DJANGO_SECRET_KEY=trocar-por-um-segredo-aleatorio-longo
DJANGO_DEBUG=0

MYSQL_HOST=mysql-container
MYSQL_PORT=3306
MYSQL_DATABASE=notificacoes
MYSQL_USER=notificacoes
MYSQL_PASSWORD=trocar

# Opcionais (valores padrão entre parênteses)
# WORKER_RITMO_S=2.5            segundos entre envios (global)
# WORKER_MAX_TENTATIVAS=5
# BLOQUEIO_FALHAS=10            chaves inválidas na janela até bloquear o IP
# BLOQUEIO_JANELA_S=600
# BLOQUEIO_DURACAO_S=900
# RETENCAO_TEXTO_DIAS=7
# RETENCAO_METADADOS_DIAS=90
# LOG_LEVEL=INFO
